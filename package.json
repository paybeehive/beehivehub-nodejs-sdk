{
  "name": "@paybeehive/beehivehub-nodejs-sdk",
  "version": "1.0.1",
  "description": "Official SDK for Beehive Hub API integration.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/paybeehive/beehivehub-nodejs-sdk"
  },
  "homepage": "https://github.com/paybeehive/beehivehub-nodejs-sdk#readme",
  "bugs": {
    "url": "mailto:contato@paybeehive.com.br"
  },
  "keywords": [
    "sdk",
    "typescript",
    "beehive",
    "beehivehub",
    "beehive-hub",
    "nodejs",
    "api-client",
    "payment",
    "payments",
    "pix",
    "boleto",
    "credit-card",
    "brazil"
  ],
  "author": "Beehive",
  "license": "MIT",
  "files": ["dist"],
  "scripts": {
    "prebuild": "node -p \"'/*This file is auto generated during build, DO NOT CHANGE OR MODIFY */\\n\\nexport const BEEHIVE_SDK_VERSION = ' + JSON.stringify(require('./package.json').version) + ';'\" > src/version.ts",
    "build": "tsup ./src --out-dir ./dist --format cjs,esm --dts --silent --no-splitting --clean",
    "lint": "biome lint . --config-path=.config/biome.json",
    "format": "biome format . --write --config-path=.config/biome.json",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "prepublishOnly": "npm run build",
    "release": "changeset publish",
    "test": "jest --config=.config/jest.config.js",
    "test:coverage": "jest --config=.config/jest.config.js --coverage",
    "coverage:open": "npx open-cli coverage/lcov-report/index.html"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.2",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "lefthook": "^1.11.12",
    "open-cli": "^8.0.0",
    "ts-jest": "^29.3.2",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  }
}
